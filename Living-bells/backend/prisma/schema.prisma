generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  ADMIN
}

enum ReviewRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BAD
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(STAFF)
  resetTokenHash       String?   @unique
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  recordedActivities   Activity[]   @relation("ActivityRecorder")
  recordedAttendances  Attendance[] @relation("AttendanceRecorder")
  recordedExpenses     Expense[]    @relation("ExpenseRecorder")
  adminReviews         SundayReview[] @relation("ReviewAdmin")
  staffReviews         SundayReview[] @relation("ReviewStaff")
}

model Activity {
  id           Int          @id @default(autoincrement())
  name         String
  type         String?
  date         DateTime
  recordedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance?
  expenses     Expense[]
  recordedBy   User?        @relation("ActivityRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([recordedById])
}

model Attendance {
  id              Int      @id @default(autoincrement())
  activityId      Int      @unique
  recordedById    Int?
  childrenMale    Int      @default(0)
  childrenFemale  Int      @default(0)
  teenagersMale   Int      @default(0)
  teenagersFemale Int      @default(0)
  youthMale       Int      @default(0)
  youthFemale     Int      @default(0)
  adultsMale      Int      @default(0)
  adultsFemale    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  recordedBy      User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([recordedById])
}

model Expense {
  id           Int      @id @default(autoincrement())
  activityId   Int?
  recordedById Int?
  description  String
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([activityId])
  @@index([recordedById])
}

model SundayReview {
  id         Int          @id @default(autoincrement())
  staffId    Int
  adminId    Int
  reviewDate DateTime
  rating     ReviewRating
  comment    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  staff User @relation("ReviewStaff", fields: [staffId], references: [id], onDelete: Cascade)
  admin User @relation("ReviewAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([staffId, reviewDate])
  @@index([reviewDate])
  @@index([staffId])
}
