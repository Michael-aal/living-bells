generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  ADMIN
}

enum ReviewRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BAD
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(STAFF)
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?   @unique
  emailVerifyExpiresAt DateTime?
  resetTokenHash       String?   @unique
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  recordedActivities   Activity[]   @relation("ActivityRecorder")
  recordedAttendances  Attendance[] @relation("AttendanceRecorder")
  recordedExpenses     Expense[]    @relation("ExpenseRecorder")
  adminReviews         SundayReview[] @relation("ReviewAdmin")
  staffReviews         SundayReview[] @relation("ReviewStaff")
  attendanceRecords    AttendanceRecord[] @relation("AttendanceRecordCreator")
  financialRecords     FinancialRecord[] @relation("FinancialRecordCreator")
}

model Activity {
  id           Int          @id @default(autoincrement())
  name         String
  type         String?
  date         DateTime
  recordedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance?
  expenses     Expense[]
  recordedBy   User?        @relation("ActivityRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([recordedById])
}

model Attendance {
  id              Int      @id @default(autoincrement())
  activityId      Int      @unique
  recordedById    Int?
  childrenMale    Int      @default(0)
  childrenFemale  Int      @default(0)
  teenagersMale   Int      @default(0)
  teenagersFemale Int      @default(0)
  youthMale       Int      @default(0)
  youthFemale     Int      @default(0)
  adultsMale      Int      @default(0)
  adultsFemale    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  recordedBy      User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([recordedById])
}

model Expense {
  id           Int      @id @default(autoincrement())
  activityId   Int?
  recordedById Int?
  description  String
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([activityId])
  @@index([recordedById])
}

model SundayReview {
  id         Int          @id @default(autoincrement())
  staffId    Int
  adminId    Int
  reviewDate DateTime
  rating     ReviewRating
  comment    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  staff User @relation("ReviewStaff", fields: [staffId], references: [id], onDelete: Cascade)
  admin User @relation("ReviewAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([staffId, reviewDate])
  @@index([reviewDate])
  @@index([staffId])
}


/// Generic weekly attendance foundation.
/// Categories are intentionally stored as data, not as hard-coded columns,
/// so the church owner can define the final categories later.
model AttendanceRecord {
  id           Int                @id @default(autoincrement())
  serviceDate  DateTime
  recordedById Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  recordedBy   User?              @relation("AttendanceRecordCreator", fields: [recordedById], references: [id], onDelete: SetNull)
  entries      AttendanceEntry[]

  @@unique([serviceDate])
  @@index([serviceDate])
  @@index([recordedById])
}

/// One row per attendance category for a Sunday.
model AttendanceEntry {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  category           String
  count              Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@unique([attendanceRecordId, category])
  @@index([category])
}

/// Generic financial foundation for both money received and money spent.
/// The final category names and business rules will be supplied by the owner.
model FinancialRecord {
  id           Int              @id @default(autoincrement())
  type         FinancialType
  category     String
  amount       Decimal          @db.Decimal(12, 2)
  description  String?
  recordDate   DateTime
  recordedById Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  recordedBy   User?            @relation("FinancialRecordCreator", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([category])
  @@index([recordDate])
  @@index([recordedById])
  @@index([recordDate, type])
}

enum FinancialType {
  INCOME
  EXPENSE
}
