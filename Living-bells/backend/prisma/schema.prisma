generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ChurchApplicationStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  ACTIVATED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CHURCH
  RESOLVED
  CLOSED
}

model Church {
  id                Int       @id @default(autoincrement())
  name              String
  denomination      String?
  address           String?
  contactEmail      String?
  phone             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  users             User[]
  activities        Activity[]
  attendances       Attendance[]
  expenses          Expense[]
  reviews           SundayReview[]
  attendanceRecords AttendanceRecord[]
  attendanceEntries AttendanceEntry[]
  financialRecords  FinancialRecord[]
  weeklyReports     WeeklyReport[]
  reportingMonths   ReportingMonth[]
  reportingWeeks    ReportingWeek[]
  configOptions     ConfigOption[]
  staffInvitations  StaffInvitation[]
  applications      ChurchApplication[]
  supportTickets    SupportTicket[]

  @@index([name])
}

model ChurchApplication {
  id                  Int                     @id @default(autoincrement())
  churchName          String
  denomination        String?
  address             String?
  applicantName       String
  applicantEmail      String
  phone               String?
  status              ChurchApplicationStatus @default(PENDING)
  reviewNote           String?
  activationTokenHash String?                 @unique
  activationExpiresAt DateTime?
  reviewedById        Int?
  reviewedAt          DateTime?
  activatedAt         DateTime?
  churchId            Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  church              Church?                 @relation(fields: [churchId], references: [id], onDelete: SetNull)
  reviewedBy          User?                   @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantEmail])
}

model SupportTicket {
  id          Int                 @id @default(autoincrement())
  churchId    Int?
  createdById Int
  title       String
  category    String
  description String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("NORMAL")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  church      Church?             @relation(fields: [churchId], references: [id], onDelete: SetNull)
  createdBy   User                @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    SupportTicketMessage[]

  @@index([churchId, status, updatedAt])
  @@index([createdById, createdAt])
}

model SupportTicketMessage {
  id       Int          @id @default(autoincrement())
  ticketId Int
  authorId Int
  body     String
  internal Boolean      @default(false)
  createdAt DateTime    @default(now())
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author   User         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum UserRole {
  STAFF
  ADMIN
  DEV
  SECRETARY
  PASTOR
}

enum ReviewRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BAD
}

model User {
  churchId Int?
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(STAFF)
  emailVerifiedAt      DateTime?
  emailVerifyTokenHash String?   @unique
  emailVerifyExpiresAt DateTime?
  resetTokenHash       String?   @unique
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  department           String?
  position             String?
  isActive             Boolean   @default(true)
  mustChangePassword    Boolean   @default(false)
  devRecoveryKeyEncrypted String?
  devRecoveryKeyNonce     String?
  devRecoveryKeyCreatedAt DateTime?


  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  recordedActivities   Activity[]   @relation("ActivityRecorder")
  reportingMonthsCreated ReportingMonth[] @relation("ReportingMonthCreator")
  reportingWeeksCreated ReportingWeek[] @relation("ReportingWeekCreator")
  recordedAttendances  Attendance[] @relation("AttendanceRecorder")
  recordedExpenses     Expense[]    @relation("ExpenseRecorder")
  adminReviews         SundayReview[] @relation("ReviewAdmin")
  staffReviews         SundayReview[] @relation("ReviewStaff")
  attendanceRecords    AttendanceRecord[] @relation("AttendanceRecordCreator")
  financialRecords     FinancialRecord[] @relation("FinancialRecordCreator")
  weeklyReportsCreated WeeklyReport[]    @relation("WeeklyReportCreator")
  invitationsSent      StaffInvitation[]  @relation("InvitationSender")
  createdOptions       ConfigOption[]    @relation("OptionCreator")
  notifications        Notification[]
  reviewedApplications ChurchApplication[] @relation("ApplicationReviewer")
  createdSupportTickets SupportTicket[] @relation("SupportTicketCreator")
  supportMessages      SupportTicketMessage[] @relation("SupportMessageAuthor")
}

model Activity {
  churchId Int?
  id           Int          @id @default(autoincrement())
  name         String
  type         String?
  date         DateTime
  recordedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance?
  expenses     Expense[]
  reportingWeekId Int?
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  reportingWeek   ReportingWeek? @relation(fields: [reportingWeekId], references: [id], onDelete: SetNull)
  recordedBy   User?        @relation("ActivityRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([date])
  @@index([recordedById])
  @@index([reportingWeekId])
}

model Attendance {
  churchId Int?
  id              Int      @id @default(autoincrement())
  activityId      Int      @unique
  recordedById    Int?
  childrenMale    Int      @default(0)
  childrenFemale  Int      @default(0)
  teenagersMale   Int      @default(0)
  teenagersFemale Int      @default(0)
  youthMale       Int      @default(0)
  youthFemale     Int      @default(0)
  adultsMale      Int      @default(0)
  adultsFemale    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  recordedBy      User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([recordedById])
}

model Expense {
  churchId Int?
  id           Int      @id @default(autoincrement())
  activityId   Int?
  recordedById Int?
  description  String
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reportingWeekId Int?
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  reportingWeek ReportingWeek? @relation(fields: [reportingWeekId], references: [id], onDelete: SetNull)
  activity     Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([activityId])
  @@index([recordedById])
  @@index([reportingWeekId])
}

model SundayReview {
  churchId Int?
  id         Int          @id @default(autoincrement())
  staffId    Int
  adminId    Int
  reviewDate DateTime
  rating     ReviewRating
  comment    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  staff User @relation("ReviewStaff", fields: [staffId], references: [id], onDelete: Cascade)
  admin User @relation("ReviewAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([staffId, reviewDate])
  @@index([reviewDate])
  @@index([staffId])
}


/// Generic weekly attendance foundation.
/// Categories are intentionally stored as data, not as hard-coded columns,
/// so the church owner can define the final categories later.
model AttendanceRecord {
  churchId Int?
  id           Int                @id @default(autoincrement())
  serviceDate  DateTime
  recordedById Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  recordedBy   User?              @relation("AttendanceRecordCreator", fields: [recordedById], references: [id], onDelete: SetNull)
  entries      AttendanceEntry[]

  @@unique([churchId, serviceDate])
  @@index([churchId])
  @@index([serviceDate])
  @@index([recordedById])
}

/// One row per attendance category for a Sunday.
model AttendanceEntry {
  churchId Int?
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  category           String
  count              Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@unique([attendanceRecordId, category])
  @@index([category])
}

/// Generic financial foundation for both money received and money spent.
/// The final category names and business rules will be supplied by the owner.
model FinancialRecord {
  churchId Int?
  id           Int              @id @default(autoincrement())
  type         FinancialType
  category     String
  amount       Decimal          @db.Decimal(12, 2)
  description  String?
  recordDate   DateTime
  reportingWeekId Int?
  recordedById Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  reportingWeek ReportingWeek? @relation(fields: [reportingWeekId], references: [id], onDelete: SetNull)
  recordedBy   User?            @relation("FinancialRecordCreator", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([category])
  @@index([churchId])
  @@index([recordDate])
  @@index([recordedById])
  @@index([reportingWeekId])
  @@index([recordDate, type])
}

enum FinancialType {
  INCOME
  EXPENSE
}


/// Weekly management snapshot for church leadership.
model WeeklyReport {
  churchId Int?
  id               Int      @id @default(autoincrement())
  reportDate       DateTime
  reportingWeekId Int?
  numerical        Json
  spiritual        Json
  income           Json
  expenditure      Json
  totalIncome      Decimal  @db.Decimal(14, 2)
  totalExpenditure Decimal  @db.Decimal(14, 2)
  balance          Decimal  @db.Decimal(14, 2)
  createdById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  clientRequestId  String?  @unique

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  reportingWeek ReportingWeek? @relation(fields: [reportingWeekId], references: [id], onDelete: SetNull)
  createdBy User? @relation("WeeklyReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([churchId, reportDate])
  @@index([createdById])
  @@index([reportingWeekId])
  @@index([churchId])
  @@index([reportDate, createdAt])
}


model ReportingMonth {
  churchId Int?
  id          Int       @id @default(autoincrement())
  year        Int
  month       Int
  status      String    @default("OPEN")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  createdBy User? @relation("ReportingMonthCreator", fields: [createdById], references: [id], onDelete: SetNull)
  weeks     ReportingWeek[]

  @@unique([churchId, year, month])
  @@index([churchId])
  @@index([year, month])
}

model ReportingWeek {
  churchId Int?
  id          Int       @id @default(autoincrement())
  monthId     Int
  weekNumber  Int
  startDate   DateTime
  endDate     DateTime
  status      String    @default("OPEN")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  month ReportingMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ReportingWeekCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities Activity[]
  expenses Expense[]
  financialRecords FinancialRecord[]
  weeklyReports WeeklyReport[]

  @@unique([monthId, weekNumber])
  @@index([startDate, endDate])
  @@index([monthId])
}



model ConfigOption {
  churchId Int?
  id          Int      @id @default(autoincrement())
  kind        String
  name        String
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  createdBy User? @relation("OptionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([churchId, kind, name])
  @@index([churchId])
  @@index([kind])
}

model StaffInvitation {
  churchId Int?
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  department  String
  position    String
  codeHash    String    @unique
  invitedById Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([churchId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
